# Copy this file to .env and fill in your own values. .env is NOT committed to GitHub.
APP_NAME=EcoWaste
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecowaste_db
DB_USER=ecowaste_app
DB_PASSWORD=

# AI waste scanner (/materials/scan). Free key: https://aistudio.google.com/apikey
# Leave empty to turn the scanner off (the page then explains how to set it up).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
